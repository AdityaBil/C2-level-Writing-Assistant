# =============================================================================
# C2 English Writing Assistant - Environment Configuration
# =============================================================================
# Copy this file to '.env' and fill in your API key:
#   cp .env.example .env (macOS/Linux) or copy .env.example .env (Windows)
# =============================================================================

# Primary LLM Provider: 'groq', 'openai', 'openrouter', or 'custom'
# Default: groq (Blazing fast inference with Llama-3.3-70B & Llama-3.1-8B)
LLM_PROVIDER=groq

# Your API Key (Get a free fast key at https://console.groq.com/keys or https://platform.openai.com/api-keys)
LLM_API_KEY=your_api_key_here

# Model identifier
# Recommended for Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# Recommended for OpenAI: gpt-4o-mini, gpt-4o
# Recommended for OpenRouter: meta-llama/llama-3.3-70b-instruct
LLM_MODEL=llama-3.3-70b-versatile

# Optional: Custom Base URL (Leave blank for default provider endpoints)
# e.g., https://openrouter.ai/api/v1 or http://localhost:11434/v1 for Ollama
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Generation Settings (Optional Defaults)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=768
